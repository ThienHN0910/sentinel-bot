{
  "name": "sentinel-bot-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "build:bot": "pnpm --filter @sentinel/shared build && pnpm --filter @sentinel/bot build",
    "build:web": "pnpm --filter @sentinel/shared build && pnpm --filter @sentinel/web build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@9.7.0"
}
