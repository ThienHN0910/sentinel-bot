# Required for the Discord bot. Copy this file to apps/bot/.env for local development.
# For PM2 launched from the repository root, use a root .env or process environment.
DISCORD_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_discord_application_id
MONGODB_URI=mongodb://127.0.0.1:27017/sentinel-bot

# Bot/API settings; OAuth values are required to enable web management.
PORT=3000
FRONTEND_URL=http://localhost:5173
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
SESSION_SECRET=replace_with_random_32_byte_secret

# Frontend settings belong in apps/web/.env (only VITE_* values are exposed to Vite).
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:3000

# Voice Greeting & Anime/E-Girl TTS Settings
# TTS_PROVIDER: 'edge' (mặc định, hoàn toàn miễn phí, không cần key), 'elevenlabs' (giọng siêu thực), 'google' (fallback)
TTS_PROVIDER=edge
# Cấu hình giọng Edge TTS: vi-VN-HoaiMyNeural được tinh chỉnh pitch (+10Hz) và rate (+5%) để có âm điệu anime/e-girl trẻ trung
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
EDGE_TTS_PITCH=+10Hz
EDGE_TTS_RATE=+5%
# Chế độ câu thoại: 'pool' (chào linh hoạt theo sáng/trưa/tối/đêm phong cách anime/e-girl) hoặc 'custom' (theo template cố định)
GREETING_MODE=pool

# Cấu hình ElevenLabs (Tùy chọn - chỉ cần khi bạn muốn đổi sang giọng ElevenLabs)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
