{
  "name": "@sentinel/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @sentinel/shared build || true",
    "build": "vue-tsc -b && vite-ssg build",
    "preview": "vite preview",
    "verify:seo": "node scripts/check-static-pages.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@sentinel/shared": "workspace:*",
    "@unhead/vue": "2",
    "canvas-confetti": "^1.9.3",
    "gsap": "^3.12.5",
    "lucide-vue-next": "^0.414.0",
    "pinia": "^2.2.0",
    "vue": "^3.4.34",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.14.12",
    "@vitejs/plugin-vue": "^5.1.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vite-ssg": "28.3.0",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  }
}
